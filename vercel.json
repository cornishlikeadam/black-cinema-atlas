{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/media/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api|media|assets|favicon\\.svg|og\\.jpg|robots\\.txt|sitemap\\.xml|LICENSE).*)",
      "destination": "/index.html"
    }
  ]
}
