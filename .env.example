# Private server-side credentials. Never commit .env.local.
TMDB_READ_ACCESS_TOKEN=
# Alternative to the read access token:
TMDB_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used only for temporary provider 5xx errors, within the same Gemini project:
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Production origin, with no trailing slash:
PUBLIC_ORIGIN=
# Enable only after account/number/webhook verification:
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
